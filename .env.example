# ─────────────── Application ───────────────
APP_NAME="TEXSON Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ─────────────── Logging ───────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────── Database (MySQL 8.0 / MariaDB 10.6+) ───────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=texson
DB_USERNAME=texson
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ฐานข้อมูลสำหรับรัน test (RefreshDatabase จะล้างตารางทุกครั้ง — ห้ามชี้ทับ DB จริง)
DB_TEST_DATABASE=texson_test

# ─────────────── Session / Cache / Queue ───────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─────────────── Mail (ส่งใบเสนอราคา) ───────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@texson.co.th"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────── TEXSON business defaults (ทับค่าใน settings ได้) ───────────────
TEXSON_VAT_RATE=7.00
TEXSON_QUOTE_VALID_DAYS=30
TEXSON_APPROVAL_DISCOUNT_PERCENT=15
TEXSON_APPROVAL_MIN_MARGIN_PERCENT=10
TEXSON_APPROVAL_GRAND_TOTAL=500000

# ─────────────── Vite ───────────────
VITE_APP_NAME="${APP_NAME}"
